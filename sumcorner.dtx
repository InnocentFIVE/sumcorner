%  最后简单分类讨论一下即可。
% \begin{macro}{\SideSet}
%    \begin{macrocode}
\exp_args:NNe \NewDocumentCommand { \SideSet }
{ s O{} O{} m E{^\c_@@_math_subscript_token}{{}{}} t' } {
  \tex_mathop:D { }
  \IfBooleanTF { #1 } {
    \IfBooleanTF { #7 } {
      \IfBlankTF { #5 } {
        \IfBlankTF { #6 }
        { \SideSet * [ #2 ] [ #3 ] { #4 } ^ { #5 \prime } }
        { \SideSet * [ #2 ] [ #3 ] { #4 } \sb { #6 } ^ { #5 \prime } }
      } {
