% \title{萨姆之角 \pkg{sumcorner} \\ \emph{At the upper right corner of summation}}
% \author{Innocent\\
% \url{InnocentFIVE@outlook.com}}
% \maketitle
% \def\d{\mathrm{dyadic}}
% \begin{abstract}
%     我们考察了萨姆之角的存在性。
% \end{abstract}
% 
% \tableofcontents
% \begin{documentation}
% \section{引论}
% 存在一些人类使用$\sum'$来表达特殊的求和，比如说二进求和之类：
% \[
%   \sumcorner\sb{n=1}^{\floor{1/\delta^N}}
%   n^p
%   \lessapprox\sb{p,N}
%   \delta^{-Np},\quad
%   \sumcorner\sb{n=1}^{A}
%   \frac{1}{n}
%   =
%   1 - O\Bigl(\frac{1}{A}\Bigr).
% \]
% 有些人类喜欢说话，因此会用$\sum^{\d}$来表示：
% \[
%   \sumcorner[\d]\sb{n=1}^{100\floor{1/\delta^N}}
%   n^p
%   \lessapprox\sb{p,N}
%   \delta^{-Np},\quad
%   \sumcorner[\d]\sb{n=1}^{A}
%   \frac{1}{n}
%   =
%   1 - O\Bigl(\frac{1}{A}\Bigr).
% \]
% 当然，我们可以更直接，使用$\sum^2$来表示，比如说：
% \[ 
%   \sumcorner[k]\sb{j=1}^{n} :=
%   \sum\sb{j\in k^{\mathbb{N}},1\leq j\leq n},\qquad
%   \sumcorner[2]\sb{j=1}^{2^m} j = \Theta(2^m),\quad
%   \sumcorner[{\sumcorner[2]\sb{j=1}^{2^m} \frac j2}]\sb{k=1}^{2^{mn}} k = \Theta(2^{n-m}).
% \]
% 当然，这会使公式稍微变长一些。
% 
% 那么，也存在一些人类会询问，如果是 |\textstyle| 情形呢？
% 
% 是的，为了防止 |\textstyle| 等情形引发歧义，我们在所有情况都需要保证 |\limits|，也就是
% $\sumcorner\sb{n=1}^{\floor{1/\delta^N}}$。
% 
% 综上所述，我们证明了萨姆之角的存在性。
% 
% \section{使用方法}
% \begin{function}{\SideSet}
% \begin{fsyntax}
%     \SideSet (*\oarg{*}*) [^(*\meta{上标}*)_(*\meta{下标}*)] [^(*\meta{上标}*)_(*\meta{下标}*)] (*\marg{萨姆}*)
% \end{fsyntax}
% 这样就可以了。使用 |*| 和不使用 |*| 的区别是：
% \[
% \sumcorner*^{100A+10B}\sb {j=B} f(j) ,\quad
% \sumcorner^{100A+10B}\sb {j=B} f(j) .
% \]
% \end{function}
% 我们给出一个复杂一点的例子：
% \begin{latexexample}
%   \[
%     \left[
%       \SideSet
%       [ ^{\mathrm{LU}} _{\mathrm{LD}} \mathbf{k} ]
%       [ ^{\mathrm{v}} _{\mathbf{C}} ]
%       {\text{F-}\mathopen{}\bigcup}
%       _{\cs{SideSet}}^{\textsl{the~corner~of~summation}} \mathrm{me}^{50}
%     \right]
%     =
%     \text{Thursday}
%   \]
% \end{latexexample}
% \[
%  \left[
%   \SideSet*
%   [ ^{\mathrm{LU}} \sb {\mathrm{LD}}\mathbf{k} ]
%   [ ^{\mathrm{v}} \sb {\mathbf{C}} ]
%   {\text{F-}\mathopen{}\bigcup}
%   \sb {\cs{SideSet}}^{\textsl{the~corner~of~summation}} \mathrm{me}^{50}
% \right] = \text{Thursday}
% \]
% \end{documentation}
% 
% \EnableImplementation
% \begin{implementation}
% \newgeometry{
%   left      = 2.2 in,
%   right     = 1.00 in,
%   top       = 1.25 in,
%   bottom    = 1.00 in,
%   marginpar = 2.25 in
% }
% \section{实现细节}
