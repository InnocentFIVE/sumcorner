% \subsection{具体实现}
% \begin{macro}{\@@_mathpalette:nnnn}
%    首先是一个 |\mathpalette| 的多元替代，
%    \begin{macrocode}
\cs_new:Npn \@@_mathpalette:nnnn #1#2#3#4 {
  \tex_mathchoice:D { #1\tex_displaystyle:D { #2 } { #3 } { #4 } }
  { #1\tex_textstyle:D { #2 } { #3 } { #4 } }
  { #1\tex_scriptstyle:D { #2 } { #3 } { #4 } }
  { #1\tex_scriptscriptstyle:D { #2 } { #3 } { #4 } }
}
%    \end{macrocode}
% \end{macro}
% 以及一些辅助命令，
% \begin{macro}{\@@_prg_until_q_stop:,\@@_auxi:w,\@@_auxii:w,\@@_auxiii:w}
%    \begin{macrocode}
\cs_set:Npn \@@_prg_until_q_stop: #1 \q_stop { \prg_do_nothing: }
\exp_args:NNe \NewDocumentCommand { \@@_auxi:w }
{ mE{^\c_@@_math_subscript_token}{{}{}} } {
  \hbox_set:Nn \l_tmpa_box { $ #1 ^ { #2 } $ }
  \dim_set:Nn \l_@@_tmpg_dim { \box_wd:N \l_tmpa_box }
  \hbox_set:Nn \l_tmpa_box { $ #1 \sb { #3 } $ }
  \dim_set:Nn \l_@@_tmpf_dim { \box_wd:N \l_tmpa_box }
  \dim_set:Nn \l_@@_tmpe_dim { \l_@@_tmpk_dim 
  - \dim_max:nn { \l_@@_tmpg_dim }
  { \l_@@_tmpf_dim } }
  \@@_prg_until_q_stop:
}
\exp_args:NNe \NewDocumentCommand { \@@_auxii:w }
  { mO{}O{}mmE{^\c_@@_math_subscript_token}{{}{}} } {
  ^ { #4 #6 #2 } \sb { #5 #7 #3 }
}
\exp_args:NNe \NewDocumentCommand { \@@_auxiii:w }
  { mO{}O{}mmE{^\c_@@_math_subscript_token}{{}{}} } {
  ^ { #4 #6 #2 } \sb { #5 #7 #3 }
  \tex_kern:D \dim_max:nn
  { \dim_min:nn { \l_@@_tmpi_dim }
    { \l_@@_tmph_dim } - \l_@@_tmpe_dim }
  { \c_zero_dim }
}
%    \end{macrocode}
%  \end{macro}
% 然后一通爆算，
%  \begin{macro}{\@@_aux:nnnnnnn}
%    \begin{macrocode}
\NewDocumentCommand { \@@_aux:nnnnnnn }{ smmmmmm } {
  \hbox_set:Nn \l_@@_tmpa_box { $ #4 #7 $ }
  \hbox_set:Nn \l_@@_tmpe_box { $ #4 ^ { #5 } $ }
  \hbox_set:Nn \l_@@_tmpf_box { $ #4 \sb { #6 } $ }
  \hbox_set:Nn \l_@@_tmpd_box { $ #4 #2 $ }
  \dim_set:Nn \l_@@_tmpk_dim { \box_wd:N \l_@@_tmpd_box }
  \dim_set:Nn \l_@@_tmpb_dim {
    \dim_max:nn { \box_wd:N \l_@@_tmpe_box }
    { \box_wd:N \l_@@_tmpf_box }
  }
  \hbox_set:Nn \l_@@_tmpb_box { \box_use:N \c_empty_box }
  \box_set_ht:Nn \l_@@_tmpb_box 
  { \box_ht:N \l_@@_tmpa_box }
  \box_set_dp:Nn \l_@@_tmpb_box 
  { \box_dp:N \l_@@_tmpa_box }
  \dim_compare:nNnTF { \box_wd:N \l_@@_tmpe_box } >
    { \box_wd:N \l_@@_tmpa_box } {
      \dim_set:Nn \l_@@_tmpi_dim {
        \dim_eval:n { ( \box_wd:N \l_@@_tmpe_box -
          \box_wd:N \l_@@_tmpa_box ) / 2 }
      }
    } { \dim_set:Nn \l_@@_tmpi_dim { \c_zero_dim } }
  \dim_compare:nNnTF { \box_wd:N \l_@@_tmpf_box } >
    { \box_wd:N \l_@@_tmpa_box } {
      \dim_set:Nn \l_@@_tmph_dim {
        \dim_eval:n { ( \box_wd:N \l_@@_tmpf_box -
          \box_wd:N \l_@@_tmpa_box ) / 2 }
      }
    } { \dim_set:Nn \l_@@_tmph_dim { \c_zero_dim } }
  \IfBooleanTF { #1 } {
    \hbox_set:Nn \l_@@_tmpc_box {
      $ #4 #7 \nolimits \@@_auxii:w
        { #4 } { } { } #3 $
    }
  } {
    \hbox_set:Nn \l_@@_tmpc_box {
      $ #4 #7 \nolimits \@@_auxii:w
        { #4 }
        { \tex_kern:D \l_@@_tmpi_dim }
        { \tex_kern:D \l_@@_tmph_dim } #3 $
    }
  }
  \dim_set:Nn \l_@@_tmpa_dim {
    \box_wd:N \l_@@_tmpc_box - \box_wd:N \l_@@_tmpa_box
  }
  \dim_set:Nn \l_@@_tmpc_dim
  {
    \dim_max:nn 
    { \box_wd:N \l_@@_tmpc_box - 
      \box_wd:N \l_@@_tmpa_box }
    { ( \l_@@_tmpb_dim - \box_wd:N \l_@@_tmpa_box ) / 2 }
    - \dim_max:nn { \c_zero_dim }
    { \l_@@_tmpb_dim - \box_wd:N \l_@@_tmpa_box } / 2
    - \c_zero_dim
  }
  \@@_auxi:w { #4 } #2 \q_stop
  \dim_set:Nn \l_@@_tmpj_dim 
  { \dim_max:nn { \l_@@_tmph_dim } 
    { \l_@@_tmpi_dim } }
  \IfBooleanTF { #1 } {
    \dim_set:Nn \l_tmpa_dim { \l_@@_tmpj_dim }
    \dim_set:Nn \l_tmpb_dim { \l_tmpa_dim }
    \tex_kern:D -\l_@@_tmpe_dim
    \tex_kern:D -\l_@@_tmpj_dim
    \tex_kern:D -\l_@@_tmpk_dim
    \tex_kern:D \dim_max:nn {
      \l_@@_tmpj_dim
    } {
      \l_@@_tmpe_dim +
      \dim_max:nn { \l_@@_tmpg_dim } { \l_@@_tmpf_dim }
    }
  } {
    \box_set_ht:Nn \l_@@_tmpc_box 
      { \box_ht:N \l_@@_tmpb_box }
    \box_set_dp:Nn \l_@@_tmpc_box 
      { \box_dp:N \l_@@_tmpb_box }
    \dim_set:Nn \l_tmpa_dim {
      \dim_max:nn { \l_@@_tmpj_dim } 
      { \l_@@_tmpe_dim }
      - \dim_max:nn { \l_@@_tmpi_dim }
      { \l_@@_tmpe_dim }
    }
    \dim_set:Nn \l_tmpb_dim {
      \dim_max:nn { \l_@@_tmpj_dim } 
      { \l_@@_tmpe_dim }
      - \dim_max:nn { \l_@@_tmph_dim } 
      { \l_@@_tmpe_dim }
    }
    \dim_set:Nn \l_@@_tmpd_dim {
    \dim_min:nn
      { \l_tmpa_dim + \l_@@_tmpk_dim - \l_@@_tmpg_dim }
      { \l_tmpb_dim + \l_@@_tmpk_dim - \l_@@_tmpf_dim }
    }
    \tex_kern:D -\l_@@_tmpd_dim
  }
  \hbox_set:Nn \l_tmpa_box {
    $
      #4
      \box_use:N \l_@@_tmpb_box
      \@@_auxiii:w
      { #4 }
      { \tex_kern:D \l_tmpa_dim
        \tex_kern:D \l_@@_tmpk_dim 
        \tex_kern:D -\l_@@_tmpg_dim }
      { \tex_kern:D \l_tmpb_dim
        \tex_kern:D \l_@@_tmpk_dim 
        \tex_kern:D -\l_@@_tmpf_dim } #2
        \tex_kern:D -\l_@@_tmpj_dim
    $
  }
  \tex_mathopen:D { \box_use:N \l_tmpa_box }
  \IfBooleanT { #1 } {
    \dim_compare:nNnTF 
    { \box_wd:N \l_@@_tmpe_box } >
      { \box_wd:N \l_@@_tmpa_box 
        + \l_@@_tmpe_dim } {
        \box_set_ht:Nn \l_@@_tmpc_box {
          \dim_max:nn { \box_ht:N \l_tmpa_box } 
            { \box_ht:N \l_@@_tmpc_box }
        }
      } {
        \dim_compare:nNnF 
        { \box_wd:N \l_@@_tmpe_box } >
          { \box_wd:N \l_@@_tmpa_box } {
            \box_set_ht:Nn \l_@@_tmpc_box 
              { \box_ht:N \l_@@_tmpa_box }
          } }
    \dim_compare:nNnTF 
    { \box_wd:N \l_@@_tmpf_box } >
      { \box_wd:N \l_@@_tmpa_box 
        + \l_@@_tmpe_dim } {
        \box_set_dp:Nn \l_@@_tmpc_box {
          \dim_max:nn { \box_dp:N \l_tmpa_box } 
            { \box_dp:N \l_@@_tmpc_box }
        }
      } {
        \dim_compare:nNnF 
        { \box_wd:N \l_@@_tmpf_box } >
          { \box_wd:N \l_@@_tmpa_box } {
            \box_set_dp:Nn \l_@@_tmpc_box 
              { \box_dp:N \l_@@_tmpa_box }
          }
      }
  }
  \tex_kern:D -\l_@@_tmpc_dim \tex_mathopen:D { }
  \tex_mathop:D { \tex_kern:D \l_@@_tmpa_dim
    \box_use:N \l_@@_tmpc_box
  }
  \tex_limits:D
  \tl_if_blank:nTF { #5 } { } { ^ { #5 } }
  \tl_if_blank:nTF { #6 } { } { \sb { #6 } }
}
%    \end{macrocode}
